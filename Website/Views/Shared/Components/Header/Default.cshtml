

<header class="d-flex flex-wrap justify-content-between py-3 mb-4 border-bottom">

    <ul class="nav nav-pills">
        <li class="nav-item">
            <span class="nav-link toggle-main-btn">
                <i class="fa-solid fa-bars"></i>
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house"></i>
            </a>
        </li>
    </ul>

    @if (!string.IsNullOrEmpty(Model) && Model != "Guest")
    {
        <ul class="nav nav-pills">
            <li class="nav-item">
                <span class="nav-link text-dark toggle-dark-mode">
                    <i class="fa-solid fa-circle-half-stroke"></i>
                </span>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="fa-solid fa-gauge"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Account" asp-controller="Profile" asp-action="Index">
                    <i class="fa-solid fa-user"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Feedback" asp-action="Index">
                    <i class="fa-solid fa-message"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Account" asp-controller="Auth" asp-action="Logout">Logout</a>
            </li>
        </ul>
    }
    else
    {
        <ul class="nav nav-pills">
            <li class="nav-item">
                <span class="nav-link text-dark toggle-dark-mode">
                    <i class="fa-solid fa-circle-half-stroke"></i>
                </span>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Feedback" asp-action="Index">
                    <i class="fa-solid fa-message"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Account" asp-controller="Auth" asp-action="Login">Login</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Account" asp-controller="Auth" asp-action="Register">Register</a>
            </li>
        </ul>
    }
</header>

