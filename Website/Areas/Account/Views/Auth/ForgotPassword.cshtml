@model Website.ViewModels.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="full-vw full-vh d-flex">
    <div class="card shadow border-0 m-auto" style="height:auto;width:500px;">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <section>

                        <h2>@ViewData["Title"]</h2>
                        <p>Enter your email address and we’ll send you a link to reset your password.</p>

                        <form asp-action="ForgotPassword" method="post">
                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>

                            <p class="text-center mt-3">
                                Go Back to <a asp-area="Account" asp-controller="Auth" asp-action="Login">Login</a>
                            </p>
                        </form>

                    </section>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
